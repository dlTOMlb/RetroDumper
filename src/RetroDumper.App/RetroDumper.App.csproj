<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>RetroDumper</AssemblyName>
    <RootNamespace>RetroDumper.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!--
      Mac と Linux からでも復元とビルドだけは通るようにする。

      これが無いと、ソリューションを対象にした操作が
      Windows 以外では丸ごと落ちる。テストを走らせたいだけでも、
      同じソリューションに居るこのプロジェクトで止まる。

        error NETSDK1100: このオペレーティング システムで Windows を
        対象とするプロジェクトをビルドするには、EnableWindowsTargeting
        プロパティを true に設定します。

      Windows 上では何も変わらない。Windows 以外で Windows 向けの
      ターゲットパックを取得してよい、という意味しか持たない。

      **できあがる EXE が Mac で動くわけではない。**
      WPF なので実行は Windows のみ。ここで通るのはビルドまでである。
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!--
    配布は .NET の入っていない PC でもそのまま動く単一ファイルにする。

    以前はこれをコマンド引数で渡していたため、引数を付け忘れた publish が
    dist の単一ファイル EXE を通常構成で上書きしてしまった。
    忘れようのない場所、つまりプロジェクトに書いておく。
  -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>

    <!--
      発行先もここで決める。-o を付ければそちらが優先される。
      ソリューションごと発行したときに、既定の bin の奥ではなく
      dist へ出るようにしておく。Avalonia 版は dist-avalonia。
    -->
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\dist\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RetroDumper.Core\RetroDumper.Core.csproj" />
  </ItemGroup>

</Project>
