<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Avalonia に GroupBox が無いので、見出し付きの枠を用意する。
    WPF 版の 7 箇所をそのまま置き換えられる形にしてある。
  -->
  <Style Selector="HeaderedContentControl.group">
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="#D4D4D8" BorderThickness="1" CornerRadius="4" Padding="10,8,10,10">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Header}"
                       FontWeight="Bold" Foreground="#3F3F46" Margin="0,0,0,6" />
            <ContentPresenter Content="{TemplateBinding Content}" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- 並びの既定。WPF は Margin を個別に書いていたが、Spacing でまとめる -->
  <Style Selector="StackPanel.form">
    <Setter Property="Spacing" Value="4" />
  </Style>

  <Style Selector="StackPanel.bar">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="6" />
  </Style>

  <!-- 見出しラベル。WPF の Label は余白が違うので揃える -->
  <Style Selector="TextBlock.caption">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.note">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="#666" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style Selector="TextBlock.danger">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="#A00" />
    <Setter Property="FontSize" Value="11" />
  </Style>

</Styles>
